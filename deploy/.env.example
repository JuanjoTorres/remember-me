# Copy to `.env` on the host, next to compose.prod.yaml. Never commit the real file.

# Images published by the deploy workflow: ghcr.io/<owner>/<repo>/<environment>, all in lowercase.
# <environment> is `staging` or `production` and must match this host.
IMAGE_PREFIX=ghcr.io/owner/remember-me/production
# Rewritten by the deploy workflow on every deploy (v1.2.3 in production, main-<commit> in staging)
IMAGE_TAG=v0.1.0

# production | staging. Staging accepts Stripe test keys; production requires live keys.
NODE_ENV=production

WEB_DOMAIN=kardoo.me
API_DOMAIN=api.kardoo.me

# Letters and digits only (it is placed inside a connection URL): openssl rand -hex 32
POSTGRES_PASSWORD=
# openssl rand -base64 48
GRANT_SIGNING_SECRET=

# Cloudflare R2
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=remember-me
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public address of the bucket (R2 custom domain), without trailing slash
MEDIA_PUBLIC_URL=https://media.kardoo.me

# Stripe (live mode keys in production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PREMIUM=
STRIPE_PRICE_ID_CUSTOM_SLUG=

# Email: only the anniversary email, one year after a paid gift is published. Optional.
# Leave as it is to send nothing (those emails wait until this is set up). To send through
# https://resend.com set MAIL_DRIVER=resend, an API key, and a sender on a domain verified there.
MAIL_DRIVER=log
RESEND_API_KEY=
MAIL_FROM=
