{
  "name": "remember-me",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "bash scripts/e2e.sh"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "6.0.3"
  }
}
