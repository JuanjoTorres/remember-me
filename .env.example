# Used by `docker compose --profile app up`. For `pnpm dev`, see apps/api/.env.example and
# apps/web/.env.example instead.

# Stripe test mode (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_replace_me
# From `stripe listen --forward-to localhost:4000/payments/webhook`
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# One-time EUR prices created in the Stripe Dashboard
STRIPE_PRICE_ID_PREMIUM=price_replace_me
STRIPE_PRICE_ID_CUSTOM_SLUG=price_replace_me
