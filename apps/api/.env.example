NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://remember:remember@localhost:5432/remember_me
# Public origin of the web app (CORS, redirect validation, QR targets)
WEB_ORIGIN=http://localhost:3000
# Signs short-lived gift grants. At least 32 random characters: openssl rand -base64 48
GRANT_SIGNING_SECRET=change-me-change-me-change-me-change-me
# Public base URL of uploaded media (MinIO locally, R2 public bucket or CDN in production)
MEDIA_PUBLIC_URL=http://localhost:9090/remember-me
# S3-compatible storage. Local: S3Mock from compose.yaml. Production: Cloudflare R2
# (S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto)
S3_ENDPOINT=http://localhost:9090
S3_REGION=auto
S3_BUCKET=remember-me
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
S3_FORCE_PATH_STYLE=true
# Stripe (test mode keys for development). The webhook secret comes from `stripe listen` locally
# or from the webhook endpoint in the Dashboard.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# One-time prices in EUR created in the Stripe Dashboard
STRIPE_PRICE_ID_PREMIUM=price_replace_me
STRIPE_PRICE_ID_CUSTOM_SLUG=price_replace_me
# Abuse protection (per client IP). Optional: these are the defaults.
# RATE_LIMIT_PER_MINUTE=240
# GIFT_CREATION_LIMIT_PER_HOUR=30
# Number of reverse proxies in front of the API (1 behind Caddy/nginx), to read the real client IP
# TRUST_PROXY_HOPS=0
# memory | redis
EVENT_BUS_DRIVER=memory
# Required only when EVENT_BUS_DRIVER=redis
# REDIS_URL=redis://localhost:6379
# Email. Nothing sends email today: the anniversary email is switched off. Leave as it is.
# log: nothing is sent | resend: sent through https://resend.com
MAIL_DRIVER=log
# Required only when MAIL_DRIVER=resend. MAIL_FROM must use a domain verified in Resend.
# RESEND_API_KEY=re_replace_me
# MAIL_FROM=kardoo.me <hello@kardoo.me>
# Daily job of this instance (deleting expired gifts): on | off. Optional, default on.
# SCHEDULED_JOBS=on
# Protection against finding gifts by trying links (per client IP, per ten minutes). Optional.
# LINK_LOOKUP_MISS_LIMIT=30
