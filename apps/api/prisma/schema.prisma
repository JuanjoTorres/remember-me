generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum GiftStatus {
  DRAFT
  PUBLISHED
}

enum CardType {
  PHOTO_TEXT
  AUDIO_NOTE
  TRIVIA
}

enum RevealTemplate {
  BASIC
  SCRATCH_CARD
  TICKET
  GIFT_BOX
}

model Gift {
  id                String         @id @default(uuid()) @db.Uuid
  slug              String         @unique
  /// True once the creator chose the slug (paid custom link); generated slugs may be replaced on publish.
  slugIsCustom      Boolean        @default(false) @map("slug_is_custom")
  customSlugPending Boolean        @default(false) @map("custom_slug_pending")
  /// SHA-256 of the secret edit token. The token itself is never stored.
  editTokenHash     String         @map("edit_token_hash")
  status            GiftStatus     @default(DRAFT)
  isPremium         Boolean        @default(false) @map("is_premium")
  /// Payment orders already applied to the gift. Plain values (no relation): they make applying a
  /// payment idempotent however often and in whatever order its event is delivered.
  appliedOrderIds   String[]       @default([]) @map("applied_order_ids")
  locale            String         @default("en")
  recipientName     String         @default("") @map("recipient_name")
  senderName        String         @default("") @map("sender_name")
  revealTemplate    RevealTemplate @default(BASIC) @map("reveal_template")
  revealHeadline    String         @default("") @map("reveal_headline")
  revealMessage     String         @default("") @map("reveal_message")
  revealDetail      String         @default("") @map("reveal_detail")
  revealImageUrl    String?        @map("reveal_image_url")
  publishedAt       DateTime?      @map("published_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  cards             GiftCard[]
  slugAliases       GiftSlugAlias[]

  @@map("gifts")
}

/// A link a published gift used to have. It keeps working, so a QR code that was already printed or
/// downloaded never breaks when the gift gets a custom link.
model GiftSlugAlias {
  slug      String   @id
  giftId    String   @map("gift_id") @db.Uuid
  gift      Gift     @relation(fields: [giftId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([giftId])
  @@map("gift_slug_aliases")
}

model GiftCard {
  id        String   @id @default(uuid()) @db.Uuid
  giftId    String   @map("gift_id") @db.Uuid
  gift      Gift     @relation(fields: [giftId], references: [id], onDelete: Cascade)
  position  Int
  type      CardType
  /// Shape depends on `type`; validated with the shared Zod contracts on every write.
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([giftId, position])
  @@map("gift_cards")
}

enum MediaKind {
  IMAGE
  AUDIO
}

/// Owned by the media module. `giftId` is a plain value: no relation to `gifts`.
model MediaAsset {
  id          String    @id @default(uuid()) @db.Uuid
  giftId      String    @map("gift_id") @db.Uuid
  kind        MediaKind
  storageKey  String    @unique @map("storage_key")
  contentType String    @map("content_type")
  bytes       Int
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([giftId])
  @@map("media_assets")
}

enum PaymentOrderStatus {
  PENDING
  PAID
  EXPIRED
  /// Money was taken but nothing could be delivered (duplicate payment, deleted gift): refund it.
  REFUND_DUE
}

/// Owned by the payments module. `giftId` is a plain value on purpose: no relation and no foreign key
/// to `gifts`, so that payments can be extracted into its own service.
model PaymentOrder {
  id                String             @id @default(uuid()) @db.Uuid
  giftId            String             @map("gift_id")
  status            PaymentOrderStatus @default(PENDING)
  stripeSessionId   String?            @unique @map("stripe_session_id")
  /// Stripe Checkout page of this order, so that asking again returns the same session.
  checkoutUrl       String?            @map("checkout_url")
  includeCustomSlug Boolean            @default(false) @map("include_custom_slug")
  customSlug        String?            @map("custom_slug")
  /// Amount charged, in the smallest currency unit, as reported by Stripe.
  amountTotal       Int?               @map("amount_total")
  currency          String?
  createdAt         DateTime           @default(now()) @map("created_at")
  paidAt            DateTime?          @map("paid_at")

  @@index([giftId])
  @@map("payment_orders")
}

/// One row per Stripe event received: makes webhook handling idempotent.
model PaymentWebhookLog {
  eventId     String    @id @map("event_id")
  type        String
  receivedAt  DateTime  @default(now()) @map("received_at")
  /// Set once the event was fully handled. A retry of an unfinished event is processed again.
  processedAt DateTime? @map("processed_at")

  @@map("payment_webhook_logs")
}
